{
  "builder": {
    "gc": {
      "policy": [
        {
          "all": true,
          "unused-for": 2592000
        },
        {
          "all": true,
          "unused-build-cache-size": 5368709120
        }
      ]
    }
  },
  "buildkit": {
    "inline-cache": true,
    "network": "host"
  },
  "features": {
    "containerd-snapshotter": false
  }
}
